# Copy to .env and fill in. .env is gitignored.

# --- JSearch (job discovery) ---
# Recommended: OpenWeb Ninja direct portal — free tier 200 req/month, no card.
#   https://www.openwebninja.com/api/jsearch
OPENWEBNINJA_API_KEY=
# Alternative route via RapidAPI (data-transfer limits apply)
RAPIDAPI_KEY=
# openwebninja | rapidapi
JSEARCH_PROVIDER=openwebninja

# --- OpenRouter (scoring + drafts) ---
OPENROUTER_API_KEY=

# --- Gmail IMAP (Naukri job-alert parsing) ---
# Use a Gmail app password (requires 2FA), never your real password.
# Create one at https://myaccount.google.com/apppasswords
YSEARCH_IMAP_USER=
YSEARCH_IMAP_PASSWORD=
# Gmail label your Naukri alerts are filtered into
YSEARCH_IMAP_LABEL=ysearch
